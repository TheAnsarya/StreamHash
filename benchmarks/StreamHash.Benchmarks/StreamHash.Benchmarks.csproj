<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TieredPGO>true</TieredPGO>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="acryptohashnet" Version="3.1.0" />
		<PackageReference Include="BenchmarkDotNet" Version="0.*" />
		<PackageReference Include="Blake3" Version="2.2.0" />
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
		<PackageReference Include="HashDepot" Version="3.2.0" />
		<PackageReference Include="nebulae.dotSHA3" Version="0.1.2" />
		<PackageReference Include="SauceControl.Blake2Fast" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\StreamHash.Core\StreamHash.Core.csproj" />
	</ItemGroup>

</Project>
