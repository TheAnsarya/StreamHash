<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Required for [SkipLocalsInit] performance attribute used across all hash implementations -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Package metadata -->
		<PackageId>StreamHash</PackageId>
	<Version>1.11.0</Version>
	<Authors>TheAnsarya</Authors>
	<Company>TheAnsarya</Company>
	<Description>High-performance streaming hash library for .NET 10. All 70 algorithms implemented natively in pure C# with zero heavy dependencies. Features MurmurHash3, CityHash, SpookyHash, SipHash, FarmHash, HighwayHash, MetroHash, KangarooTwelve, wyhash, xxHash, plus complete cryptographic suite (SHA-3, BLAKE, Keccak, RIPEMD, Whirlpool, Tiger, GOST, Streebog, Skein, SM3, Grøstl, JH). Unified HashFacade API with batch streaming for parallel multi-algorithm processing. SIMD-optimized: Grøstl (AES-NI), JH (SSSE3), HighwayHash (AVX2), CRC-32C (SSE4.2), BLAKE2b (AVX2). 1853+ tests, 20 algorithms faster than BouncyCastle.</Description>
	<PackageTags>hash;streaming;murmurhash;cityhash;spookyhash;siphash;farmhash;highwayhash;metrohash;kangarootwelve;wyhash;xxhash;crc32;adler32;sha256;sha3;blake2;keccak;ripemd;whirlpool;tiger;skein;groestl;jh;performance;incremental;simd;aes-ni;avx2;fnv;djb2;sdbm;batch;parallel;basic-hashes;file-verification</PackageTags>
	<PackageProjectUrl>https://github.com/TheAnsarya/StreamHash</PackageProjectUrl>
	<RepositoryUrl>https://github.com/TheAnsarya/StreamHash.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>Unlicense</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>icon.png</PackageIcon>
	<Copyright>Public Domain - The Unlicense</Copyright>
	<PackageReleaseNotes>v1.11.0: Major performance optimization release. Keccak/SHA-3 fully unrolled (now at parity with BouncyCastle). BLAKE2b/2s AVX2/SSSE3 vector loading. RIPEMD-128/320 fully unrolled. xxHash one-shot API (at parity with System.IO.Hashing). SHA-512/256 ReadOnlySpan K constants. CRC-32C SSE4.2 hardware acceleration. HighwayHash safe refactor (no unsafe code). 20 algorithms faster than reference, only 2 slower. VeryLargeFile benchmarks (10MB-1GB). 1853+ tests passing.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Source Link for debugging -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blake3" />
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>

	<!-- SIMD intrinsics support -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

</Project>
